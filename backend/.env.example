# ── MyRecon backend environment ──────────────────────────────────
# Copy to `.env` for local development. NEVER commit real secrets.

# Server
FLASK_ENV=development
PORT=5000
# SECRET_KEY=generate-a-long-random-string-in-production

# CORS, comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Caching
CACHE_ENABLED=true
CACHE_TTL=600

# ── Optional integrations (features degrade gracefully without them) ──
# Google Programmable Search (enables full-name + reverse-image search)
GOOGLE_API_KEY=
GOOGLE_CX_ID=
# Have I Been Pwned (adds official breach data on top of the free source)
HIBP_API_KEY=
# GitHub token (raises the email→user search rate limit)
GITHUB_TOKEN=
# Rich email profiles, Google review venues and LinkedIn history.
# Server-side only. Both fields are required; provider lookups use credits.
EMAIL_ENRICHMENT_ENABLED=false
OSINT_INDUSTRIES_API_KEY=
# Optional independent LinkedIn dataset enrichment (exact returned email required).
EMAIL_LINKEDIN_ENRICHMENT_ENABLED=false
PDL_API_KEY=
# Public Google review retrieval requires a source-linked contributor ID first.
# Free anonymous public contributor lookup (no key or Google session forwarded).
# Experimental Google response format; blocked/private/changed responses stay unknown.
EMAIL_GOOGLE_PUBLIC_REVIEWS_ENABLED=true
# Optional documented provider fallback; requires its own key.
EMAIL_GOOGLE_REVIEWS_ENABLED=false
SERPAPI_API_KEY=
# Free optional Google source, separately installed/authenticated GHunt 2.3.4.
# Requires Python >=3.10 in an isolated environment; backend Python may be older.
# Session file is server-side authentication material, never put it in this repo.
EMAIL_GHUNT_ENABLED=false
GHUNT_PYTHON_EXECUTABLE=
GHUNT_SESSION_FILE=
# Hosting alternative: the exact contents of the authenticated GHunt creds.m
# file (already base64). Store as a backend secret, never in Android or Git.
# The Render build installs the default .venv/ghunt/bin/python runtime.
GHUNT_SESSION_B64=
# Fetch public LinkedIn JSON-LD only for an already source-linked profile URL.
# Obeys robots.txt; login walls/blocks remain unavailable, not absent profiles.
EMAIL_LINKEDIN_PUBLIC_ENABLED=false
# Optional breach aliases and names. Password values are not forwarded.
EMAIL_BREACH_DETAILS_ENABLED=false
LEAKCHECK_APIKEY=

# ── Accounts & Extended scan packs ──
# Firebase project (public id) and Realtime Database for account state.
FIREBASE_PROJECT_ID=myrecon-bugsnaps
# FIREBASE_DB_URL=https://myrecon-bugsnaps-default-rtdb.asia-southeast1.firebasedatabase.app
# Service-account JSON, raw or base64. Unset = accounts off (memory store).
FIREBASE_SERVICE_ACCOUNT=
GUEST_SCANS_PER_DAY=5
FULL_SCAN_SLOTS=1
# Keep a single Gunicorn worker so these process-local limits cover the service.
SWEEP_CONCURRENCY=8
FULL_SCAN_DEADLINE_SECONDS=300
EXTENDED_SCAN_DEADLINE_SECONDS=1800
# Razorpay: key id is public; secret + webhook secret are not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# International: publish a USD 3.99 Shop item with one required question,
# "MyRecon activation code". Disable quantity selection and member discounts.
# Enter the item's exact /<creator>/e/<id> URL and matching numeric ID.
# Subscribe to extra_purchase.created and extra_purchase.updated.
# Endpoint: /api/billing/buymeacoffee/webhook. Secret belongs in Render only.
BUYMEACOFFEE_SHOP_URL=
BUYMEACOFFEE_ITEM_ID=
BUYMEACOFFEE_WEBHOOK_SECRET=

# PayPal Extended pack, USD 3.99. Set fresh credentials in Render only.
# Webhook: /api/billing/paypal/webhook
# Events: CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.COMPLETED
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
