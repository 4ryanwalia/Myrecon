# ── MyRecon backend environment ──────────────────────────────────
# Copy to `.env` for local development. NEVER commit real secrets.

# Server
FLASK_ENV=development
PORT=5000
# SECRET_KEY=generate-a-long-random-string-in-production

# CORS, comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Caching
CACHE_ENABLED=true
CACHE_TTL=600

# ── Optional integrations (features degrade gracefully without them) ──
# Google Programmable Search (enables full-name + reverse-image search)
GOOGLE_API_KEY=
GOOGLE_CX_ID=
# Have I Been Pwned (adds official breach data on top of the free source)
HIBP_API_KEY=
# GitHub token (raises the email→user search rate limit)
GITHUB_TOKEN=
# Optional rich email sources. Keep provider credentials on Render only.
# Sources remain explicitly unavailable until enabled and configured.
EMAIL_ENRICHMENT_ENABLED=false
OSINT_INDUSTRIES_API_KEY=
EMAIL_LINKEDIN_ENRICHMENT_ENABLED=false
PDL_API_KEY=
EMAIL_GOOGLE_REVIEWS_ENABLED=false
SERPAPI_API_KEY=
EMAIL_LINKEDIN_PUBLIC_ENABLED=false
EMAIL_BREACH_DETAILS_ENABLED=false
LEAKCHECK_APIKEY=
# Google exact-email identity and bounded anonymous public contributor reviews.
# The Render build installs a dedicated GHunt 2.3.4 interpreter automatically.
EMAIL_GHUNT_ENABLED=false
EMAIL_GOOGLE_PUBLIC_REVIEWS_ENABLED=false
# Optional absolute runtime override and hosting secret-file session path.
GHUNT_PYTHON_EXECUTABLE=
GHUNT_SESSION_FILE=
# Secret alternative: exact contents of authenticated creds.m (already base64).
# Never commit operator sessions or put them in Android resources.
GHUNT_SESSION_B64=

# ── Accounts & Extended scan packs ──
# Firebase project (public id) and Realtime Database for account state.
FIREBASE_PROJECT_ID=myrecon-bugsnaps
# FIREBASE_DB_URL=https://myrecon-bugsnaps-default-rtdb.asia-southeast1.firebasedatabase.app
# Service-account JSON, raw or base64. Unset = accounts off (memory store).
FIREBASE_SERVICE_ACCOUNT=
GUEST_SCANS_PER_DAY=5
FULL_SCAN_SLOTS=1
# Razorpay: key id is public; secret + webhook secret are not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# International: publish a USD 3.99 Shop item with one required question,
# "MyRecon activation code". Disable quantity selection and member discounts.
# Enter the item's exact /<creator>/e/<id> URL and matching numeric ID.
# Subscribe to extra_purchase.created and extra_purchase.updated.
# Endpoint: /api/billing/buymeacoffee/webhook. Secret belongs in Render only.
BUYMEACOFFEE_SHOP_URL=
BUYMEACOFFEE_ITEM_ID=
BUYMEACOFFEE_WEBHOOK_SECRET=

# PayPal Extended pack, USD 3.99. Set fresh credentials in Render only.
# Webhook: /api/billing/paypal/webhook
# Events: CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.COMPLETED
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Optional manually started Colab CPU worker. Keep disabled until configured.
# Generate a NEW dedicated random token; never use Firebase/payment keys here.
SCAN_OFFLOAD_ENABLED=false
SCAN_WORKER_TOKEN=
# Owner-only worker health monitor. This must be a different random token from
# SCAN_WORKER_TOKEN. Store it in Apps Script Script Properties, never a browser.
SCAN_WORKER_STATUS_TOKEN=
# Google account allowed to use /worker-console/. The launcher URL is returned
# only after that Firebase user has been verified by Render.
SCAN_WORKER_OPERATOR_EMAIL=
SCAN_WORKER_LAUNCHER_URL=
SCAN_WORKER_FRESH_SECONDS=30
SCAN_WORKER_OFFLINE_SECONDS=180
SCAN_JOB_LIMIT=4
SCAN_LEASE_SECONDS=90
SCAN_WORKER_WAIT_SECONDS=20
SCAN_JOB_TTL_SECONDS=86400
SWEEP_CONCURRENCY=8
SWEEP_FULL_DEADLINE_SECONDS=300
SWEEP_EXTENDED_DEADLINE_SECONDS=1800
