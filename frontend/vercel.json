{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-site.js",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/find/roblox-profile",
      "destination": "/find/roblox-user",
      "permanent": true
    },
    {
      "source": "/find/roblox-profile.html",
      "destination": "/find/roblox-user",
      "permanent": true
    },
    {
      "source": "/privacy/opt-out-of-spokeo",
      "destination": "/privacy/opt-out-spokeo",
      "permanent": true
    },
    {
      "source": "/privacy/opt-out-of-spokeo.html",
      "destination": "/privacy/opt-out-spokeo",
      "permanent": true
    },
    {
      "source": "/privacy/opt-out-of-beenverified",
      "destination": "/privacy/remove-beenverified-record",
      "permanent": true
    },
    {
      "source": "/privacy/opt-out-of-beenverified.html",
      "destination": "/privacy/remove-beenverified-record",
      "permanent": true
    },
    {
      "source": "/privacy/opt-out-of-whitepages",
      "destination": "/privacy/delete-whitepages-info",
      "permanent": true
    },
    {
      "source": "/privacy/opt-out-of-whitepages.html",
      "destination": "/privacy/delete-whitepages-info",
      "permanent": true
    },
    {
      "source": "/privacy/remove-personal-info-from-google-audit",
      "destination": "/privacy/request-google-search-removal",
      "permanent": true
    },
    {
      "source": "/privacy/remove-personal-info-from-google-audit.html",
      "destination": "/privacy/request-google-search-removal",
      "permanent": true
    },
    {
      "source": "/privacy/data-broker-opt-out-checklist",
      "destination": "/privacy/remove-data-from-people-search-sites",
      "permanent": true
    },
    {
      "source": "/privacy/data-broker-opt-out-checklist.html",
      "destination": "/privacy/remove-data-from-people-search-sites",
      "permanent": true
    },
    {
      "source": "/content/:path*",
      "destination": "/breaches/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/benchmarks.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://www.googletagservices.com https://adservice.google.com https://googleads.g.doubleclick.net https://fundingchoicesmessages.google.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://www.gstatic.com https://apis.google.com https://www.googletagmanager.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://myrecon.onrender.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://api.razorpay.com https://lumberjack.razorpay.com https://api.pwnedpasswords.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://csi.gstatic.com https://fundingchoicesmessages.google.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://stats.g.doubleclick.net; frame-src https://myrecon-bugsnaps.firebaseapp.com https://accounts.google.com https://api.razorpay.com https://checkout.razorpay.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://fundingchoicesmessages.google.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/features",
      "destination": "/features.html"
    },
    {
      "source": "/enterprise-osint-api",
      "destination": "/enterprise-osint-api.html"
    },
    {
      "source": "/privacy-audit",
      "destination": "/privacy-audit.html"
    },
    {
      "source": "/find/:slug",
      "destination": "/find/:slug.html"
    },
    {
      "source": "/privacy/:slug",
      "destination": "/privacy/:slug.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    },
    {
      "source": "/vs/:slug",
      "destination": "/vs/:slug.html"
    }
  ]
}
