<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget.

     Deliberately text-only. A widget competes with the launcher's wallpaper on
     every device, so anything decorative reads as clutter; what earns the space
     is a number that changed since the user last looked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MYRECON"
        android:textSize="10sp"
        android:letterSpacing="0.14"
        android:textStyle="bold"
        android:textColor="#647089" />

    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#E8EEF7"
        android:text="Run a scan to begin" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="#9AABC4"
        android:text="Tap to open MyRecon" />

    <TextView
        android:id="@+id/widget_breach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="#647089" />
</LinearLayout>
