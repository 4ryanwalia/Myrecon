<!--
  Launcher foreground: the mark alone, no plate — the adaptive icon's
  background layer supplies that. Adaptive icons are 108x108 with only the
  centre 72x72 guaranteed visible, so the 40-unit artwork is translated and
  scaled to sit inside that safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="24"
        android:translateY="24"
        android:scaleX="1.5"
        android:scaleY="1.5">

        <!-- lens -->
        <path
            android:pathData="M26.5,18a8.5,8.5 0,1 1,-17 0a8.5,8.5 0,1 1,17 0"
            android:strokeWidth="2.4">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="9.5" android:startY="9.5"
                    android:endX="26.5" android:endY="26.5"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="1" android:color="#6366F1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- pupil -->
        <path android:pathData="M21,18a3,3 0,1 1,-6 0a3,3 0,1 1,6 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="15" android:startY="15"
                    android:endX="21" android:endY="21"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="1" android:color="#6366F1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- crosshair ticks -->
        <path
            android:pathData="M18,6.5V9.5M18,26.5V29.5M6.5,18H9.5M26.5,18H29.5"
            android:strokeWidth="1.8"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="6.5" android:startY="6.5"
                    android:endX="29.5" android:endY="29.5"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="1" android:color="#6366F1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- handle -->
        <path
            android:pathData="M24.2,24.2L30.6,30.6"
            android:strokeWidth="2.8"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="24" android:startY="24"
                    android:endX="31" android:endY="31"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="1" android:color="#6366F1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
