<?xml version="1.0" encoding="utf-8"?>
<!-- Tint block behind the glyph. Carries the accent without colouring the whole
     card, which at widget size would fight the wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#12232E" />
    <corners android:radius="13dp" />
</shape>
