<?xml version="1.0" encoding="utf-8"?>
<!-- Card behind the QR widget. Same shape language as the exposure widget so
     the two sit together on a home screen, with an accent-tinted edge because
     this one is a button rather than a readout. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#0B1119" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#1B3947" />
</shape>
