    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#22D3EE"
        android:fillType="evenOdd"
        android:pathData="M2,2 h8 v8 h-8 z M4,4 v4 h4 v-4 z M5,5 h2 v2 h-2 z M14,2 h8 v8 h-8 z M16,4 v4 h4 v-4 z M17,5 h2 v2 h-2 z M2,14 h8 v8 h-8 z M4,16 v4 h4 v-4 z M5,17 h2 v2 h-2 z" />

    <path
        android:fillColor="#22D3EE"
        android:pathData="M14,14 h2.6 v2.6 h-2.6 z M19.4,14 h2.6 v2.6 h-2.6 z M14,19.4 h2.6 v2.6 h-2.6 z M19.4,19.4 h2.6 v2.6 h-2.6 z M16.7,16.7 h2.6 v2.6 h-2.6 z M12,11 h2.6 v1.6 h-2.6 z" />
</vector>
