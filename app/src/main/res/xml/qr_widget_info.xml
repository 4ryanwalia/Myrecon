<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0 on purpose: this widget never wakes the app up.

     Nothing on it changes, so a refresh could only cost battery and risk a
     stutter in the launcher process. The exposure widget refreshes hourly
     because its number moves; this one is a button. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="48dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:initialLayout="@layout/widget_qr"
    android:previewLayout="@layout/widget_qr"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/widget_qr_description"
    android:updatePeriodMillis="0" />
