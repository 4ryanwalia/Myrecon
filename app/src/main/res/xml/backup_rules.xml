<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up.

  The DataStore holds what the user has looked up and chosen to watch. Copying
  that to Google Drive would put an investigation history on infrastructure the
  user did not choose, which contradicts the whole premise of running these
  lookups on-device. Losing it on reinstall is the correct trade.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
