<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ equivalent of backup_rules. Cloud backup and direct
  device-to-device transfer are both refused, for the same reason: search
  history should not outlive the device it was created on.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
