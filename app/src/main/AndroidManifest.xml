<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lookups call the MyRecon API; the password check calls Pwned Passwords
         directly with a 5-character hash prefix. Nothing else leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Haptic feedback on taps and scan events. A normal permission, granted
         at install with no runtime prompt. Without it the Vibrator calls fail
         silently and every touch feels inert. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- QR scanning. Requested at the point of use with a rationale, never at
         launch. Frames are analysed in memory and never written anywhere. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Declared not-required so the app still installs on devices without a
         camera; the scanner tab simply explains it is unavailable. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".MyReconApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Myrecon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>