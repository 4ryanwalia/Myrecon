<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lookups call the MyRecon API; the password check calls Pwned Passwords
         directly with a 5-character hash prefix. Nothing else leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Haptic feedback on taps and scan events. A normal permission, granted
         at install with no runtime prompt. Without it the Vibrator calls fail
         silently and every touch feels inert. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- QR scanning. Requested at the point of use with a rationale, never at
         launch. Frames are analysed in memory and never written anywhere. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Breach alerts. Runtime-requested on Android 13+, and only when the user
         turns the watch on — never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Declared not-required so the app still installs on devices without a
         camera; the scanner tab simply explains it is unavailable. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".MyReconApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Myrecon">

        <!-- AdMob application id, injected per build type. Debug gets Google's
             public test id so development taps never register as invalid
             traffic against the live account. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Keeps ad SDK initialisation off the cold-start path. Without these
             the SDK initialises during Application.onCreate and measurably
             delays the first frame. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Home screen widget. Exported because the launcher hosts it. -->
        <receiver
            android:name=".widget.ExposureWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/exposure_widget_info" />
        </receiver>

    </application>

</manifest>