{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.myrecon.xyz/schemas/comparison.schema.json",
  "title": "MyRecon comparison page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "slug",
    "status",
    "title",
    "description",
    "h1",
    "focus_keyword",
    "intro",
    "sections",
    "sources",
    "reviewed_at",
    "modified_at",
    "reviewer",
    "cta",
    "competitor",
    "capabilities",
    "benchmark",
    "pros",
    "cons",
    "migration_note",
    "faq"
  ],
  "properties": {
    "kind": {
      "const": "comparison"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 25,
      "maxLength": 70
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 180
    },
    "h1": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "focus_keyword": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "intro": {
      "type": "string",
      "minLength": 80
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "body": {
            "type": "string",
            "minLength": 80
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "modified_at": {
      "type": "string",
      "format": "date"
    },
    "reviewer": {
      "type": "string",
      "minLength": 3
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "href": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9/?=&-]*)$"
        }
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "official_url",
        "interface"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "official_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "interface": {
          "enum": [
            "CLI",
            "web",
            "desktop",
            "mixed"
          ]
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "myrecon",
          "competitor",
          "evidence_url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "myrecon": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "competitor": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "evidence_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "benchmark": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "methodology",
            "sample_size",
            "measured_at",
            "myrecon_seconds",
            "competitor_seconds"
          ],
          "properties": {
            "methodology": {
              "type": "string",
              "minLength": 80
            },
            "sample_size": {
              "type": "integer",
              "minimum": 3
            },
            "measured_at": {
              "type": "string",
              "format": "date"
            },
            "myrecon_seconds": {
              "type": "number",
              "minimum": 0
            },
            "competitor_seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "pros": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 160
      }
    },
    "cons": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 160
      }
    },
    "migration_note": {
      "type": "string",
      "minLength": 80
    },
    "faq": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "answer": {
            "type": "string",
            "minLength": 80
          }
        }
      }
    }
  }
}
